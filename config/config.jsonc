/* Limited Traders reduces the stock of all traders, with optional per-category price adjustments.
   Works with vanilla traders and *should* work with modded traders too. Probably avoid adding fence.
*/
{
    "tradersToLimit": [ /* Remove or add traders you want to have adjusted. */
        "5a7c2eca46aef81a7ca2145d", /* Mechanic */
        "5ac3b934156ae10c4430e83c", /* Ragman */
        "5c0647fdd443bc2504c2d371", /* Jaeger */
        "54cb50c76803fa8b248b4571", /* Prapor */
        "54cb57776803fa99248b456e", /* Therapist */
        "5935c25fb3acc3127c3d8cd9", /* Peacekeeper */
        "58330581ace78e27b8b10cee" /* Skier */
    ],

    "itemBlacklist": [], /* Items to leave completely untouched by this mod. */

    /* Keyed by an item tpl OR a category (parent) node id at ANY depth. For each trade the most
       specific matching entry wins, effectively prioritizing this order:
       1. the item's own tpl
       2. its immediate parent category
       3. that parent's parent, and so on up the category tree
       4. the root "Item" node 54009119af1c881c07000029 (Add this category to have a "default")
       An item that matches nothing in its chain is left completely untouched.
       Check https://localhost:6969/webui/db while the server is running for category and item IDs.
       
       A parent tree might look something like this.
       ``Item › Compound item › Weapon › Assault rifle › Colt M4A1 5.56x45 assault rifle``
    */
    "categories": {
        "5485a8684bdc2da71d8b4567": { /* Ammo */
            "base": 500, /* The base count of an item. */
            "random": 100, /* The variance of the base count. E.g. Base is 300 and random is 200, the final spread is 100-500. */
            "chanceForNoStock": 0.35, /* Chance for there to be none of an item available. Rolled for eached individual item. */
            "priceAdjustment": 1 /* Price adjustment. 2.0 means twice the price. 0.5 means half the price. */
        },
        "543be6564bdc2df4348b4568": { /* Throwable weapon */
            "base": 7,
            "random": 4,
            "chanceForNoStock": 0.2,
            "priceAdjustment": 1
        },
        "543be5dd4bdc2deb348b4569": { /* Money */
            "base": 4000,
            "random": 1500,
            "chanceForNoStock": 0,
            "priceAdjustment": 1
        },
        "5447e0e74bdc2d3c308b4567": { /* Special item */
            "base": 100,
            "random": 0,
            "chanceForNoStock": 0,
            "priceAdjustment": 1
        },
        "5448bc234bdc2d3c308b4569": { /* Magazine */
            "base": 6,
            "random": 3,
            "chanceForNoStock": 0.1,
            "priceAdjustment": 1
        },
        "543be5cb4bdc2deb348b4568": { /* Ammo container */
            "base": 15,
            "random": 3,
            "chanceForNoStock": 0.1,
            "priceAdjustment": 1
        },
        "54009119af1c881c07000029": { /* Item (root category - catch-all, i.e. the old "default") */
            "base": 6,
            "random": 3,
            "chanceForNoStock": 0.1,
            "priceAdjustment": 1
        },
        "69069986473b8fd5e80545f3": { /* Bushtail's Canted Aim */
            "base": 1000,
            "random": 0,
            "chanceForNoStock": 0,
            "priceAdjustment": 1
        }
    },

    "removeMaxBuyRestrictions": true, /* Removes max buy limit */

    /* Seconds to wait after a trader's resupply before re-applying stock limits.
       Recommended to leave at 60 so BarterEconomy's (if installed) full-stock rebuild (which fires on the same resupply) lands first.
       Higher -> less chance of getting tangled, but longer full-stock window right after resupply.
    */
    "refreshDelaySeconds": 60
}
